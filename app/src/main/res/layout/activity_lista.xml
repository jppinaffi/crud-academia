<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:paddingTop="24dp">

    <EditText android:id="@+id/etBusca" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Buscar por nome ou CPF"
        android:inputType="text" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/listAlunos" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView android:id="@+id/tvVazio" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="Nenhum aluno cadastrado" android:visibility="gone" />
    </FrameLayout>

    <Button android:id="@+id/btnNovo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="+ Novo aluno" />
    <Button android:id="@+id/btnVoltar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Voltar" />
</LinearLayout>
</FrameLayout>
